# .env.example - 示例环境变量，复制为 .env 后填入真实值

# ====== 账户配置 ======
OEC_EMAIL=your-email@example.com
OEC_PASSWORD=your-password
OEC_ACCOUNT_ID=0000000000000000
OEC_VIDEO_ACCOUNT_ID=0000000000000000

# ====== 飞书群 ======
LARK_MONITOR_CHAT_ID=oc_xxx
LARK_ANCHOR_CHAT_ID=oc_xxx

# ====== 飞书排班表 ======
SHIFT_SPREADSHEET_TOKEN=your_spreadsheet_token
SHIFT_SHEET_ID=your_sheet_id

# ====== 业务参数 ======
OEC_DAILY_BUDGET=45000

# ====== Chrome / CDP ======
CHROME_USER_DATA_DIR=D:\ChromeCDP\User Data
CHROME_PROFILE_DIRECTORY=Profile 4

# ====== 运行时（ecosystem.config.cjs）======
# MONITOR_DIR 和 NODE_EXE 默认自动推导，仅在非标准路径时需要覆盖
# MONITOR_DIR=E:\path\to\project
# NODE_EXE=C:\path\to\node.exe

# ====== 日志 ======
# LOG_RETENTION_DAYS=14