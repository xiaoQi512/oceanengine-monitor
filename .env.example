# .env.example - 示例环境变量，复制为 .env 后填入真实值

# ====== 账户配置 ======
OEC_EMAIL=your-email@example.com
OEC_PASSWORD=your-password
OEC_ACCOUNT_ID=0000000000000000
OEC_VIDEO_ACCOUNT_ID=0000000000000000
ACCOUNT_NAME=
# 默认账户结构写入 src/config/accounts.json；环境变量优先覆盖 accounts.json

# ====== 飞书群 ======
LARK_MONITOR_CHAT_ID=oc_xxx
# 汇报群（兼容旧变量 LARK_ANCHOR_CHAT_ID）
LARK_REPORT_CHAT_ID=oc_xxx
# LARK_ANCHOR_CHAT_ID=oc_xxx
LARK_BOT_APP_ID=cli_xxx

# ====== 飞书排班表 ======
SHIFT_SPREADSHEET_TOKEN=your_spreadsheet_token
SHIFT_SHEET_ID=your_sheet_id

# ====== 业务参数 ======
OEC_DAILY_BUDGET=45000
# AI 对话上下文里的日预算口径，默认 60000
AI_DAILY_BUDGET=60000

# ====== 运行/测试开关 ======
OEC_FORCE=0
OEC_DRY_RUN=0
OEC_SILENT=0
OEC_PM2_TEST=0
OEC_NO_THROTTLE=0
OEC_SHIFT_LABEL=
OEC_SKIP_WRITE_SHEET=0
SIMULATE_CDP=0

# 大号日汇总：EOD 触发标记与 23:35 兜底标记
DAILY_SUMMARY_EOD=0
DAILY_SUMMARY_FALLBACK=0

# v2 数据库并行写入灰度：0=关闭，1=开启（默认关闭）
DB_V2_DUAL_WRITE=0
DB_V2_PRIMARY=1
OCEANENGINE_DB_PATH=
SNAPSHOT_DATA_DIR=

# ====== 路径覆盖 ======
ACTION_QUEUE_FILE=
ACTION_LOCK_FILE=
ACTION_AUDIT_FILE=
ACTION_PENDING_FILE=
CDP_PORT=9222
FEEDBACK_PORT=8899

# ====== Dashboard 远程隧道 ======
DASHBOARD_TUNNEL_PORT=8898
DASHBOARD_UPSTREAM=http://127.0.0.1:8899
# 留空时自动读取 CodeBuddy settings.json 的 gateway.password
DASHBOARD_TUNNEL_PASSWORD=
# CLOUDFLARED_PATH=C:\path\to\cloudflared.exe
# CODEBUDDY_SETTINGS_PATH=C:\Users\HTF2026\.codebuddy\settings.json
# PYTHON=python

# ====== Chrome / CDP ======
CHROME_USER_DATA_DIR=D:\ChromeCDP\User Data
CHROME_PROFILE_DIRECTORY=Profile 4

# ====== 运行时（ecosystem.config.cjs）======
# MONITOR_DIR 和 NODE_EXE 默认自动推导，仅在非标准路径时需要覆盖
# MONITOR_DIR=E:\path\to\project
# NODE_EXE=C:\path\to\node.exe
# AGENT=codex

# ====== 日志 ======
# LOG_RETENTION_DAYS=14
