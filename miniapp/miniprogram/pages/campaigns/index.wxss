.page { padding-bottom: 60rpx; }
.header {
  padding: 100rpx 32rpx 20rpx;
  display: flex; justify-content: space-between; align-items: flex-end;
}
.header-title { font-size: 40rpx; font-weight: 700; color: #FFF; }
.header-sub { font-size: 22rpx; color: #8A93A8; }

.chips-scroll { white-space: nowrap; padding: 0 24rpx; margin-bottom: 24rpx; }
.chips { display: inline-flex; }

/* 计划卡 */
.camp-card {
  background: #141A30; border-radius: 24rpx;
  padding: 28rpx; margin: 0 24rpx 24rpx;
}
.camp-head { display: flex; justify-content: space-between; align-items: flex-start; }
.camp-name { font-size: 28rpx; color: #FFF; font-weight: 600; flex: 1; margin-right: 16rpx; }
.camp-status { flex-shrink: 0; font-size: 20rpx; padding: 6rpx 18rpx; border-radius: 999rpx; }
.st-on { background: rgba(46,219,139,.12); color: #2EDB8B; }
.st-off { background: rgba(138,147,168,.12); color: #8A93A8; }

.camp-budget { margin: 24rpx 0 8rpx; }
.progress-track { height: 12rpx; background: #1E2540; border-radius: 999rpx; overflow: hidden; }
.progress-fill { height: 100%; border-radius: 999rpx; background: linear-gradient(90rdeg, #2A4BD8, #5B8CFF); }
.fill-hot { background: linear-gradient(90rdeg, #D84A2A, #FF5A5A); }
.camp-budget-meta {
  display: flex; justify-content: space-between;
  font-size: 22rpx; color: #6B7280; margin-top: 10rpx;
}

.camp-metrics { display: flex; gap: 48rpx; margin: 16rpx 0 8rpx; }
.camp-metric { display: flex; align-items: baseline; gap: 12rpx; }
.cm-label { font-size: 22rpx; color: #6B7280; }
.cm-value { font-size: 30rpx; font-weight: 600; color: #FFF; }
.cm-delta { font-size: 20rpx; }

.camp-actions {
  display: flex; gap: 16rpx; margin-top: 24rpx;
  padding-top: 24rpx; border-top: 1rpx solid #1A2138;
}
.act-btn {
  flex: 1; text-align: center; padding: 16rpx 0;
  border-radius: 14rpx; font-size: 26rpx;
}
.act-pause { background: rgba(255,90,90,.12); color: #FF5A5A; }
.act-enable { background: rgba(46,219,139,.12); color: #2EDB8B; }
.act-budget {
  background: linear-gradient(135deg, #2A4BD8, #5B8CFF);
  color: #FFF; font-weight: 600;
  box-shadow: 0 4rpx 16rpx rgba(42, 75, 216, .35);
}
.act-budget:active { opacity: .85; }

/* 底部弹层 */
.mask {
  position: fixed; inset: 0;
  background: rgba(0,0,0,.55);
  z-index: 100;
  display: flex; align-items: flex-end;
}
.sheet {
  width: 100%; background: #161C34;
  border-radius: 32rpx 32rpx 0 0;
  padding: 40rpx 36rpx calc(40rpx + env(safe-area-inset-bottom));
}
.sheet-title { font-size: 32rpx; font-weight: 700; color: #FFF; }
.sheet-camp { font-size: 26rpx; color: #A8B0C4; margin-top: 12rpx; }
.sheet-current { font-size: 22rpx; color: #6B7280; margin-top: 6rpx; }

.quick-row { display: flex; gap: 16rpx; margin: 32rpx 0; }
.quick-btn {
  flex: 1; text-align: center; padding: 20rpx 0;
  background: #1E2540; border-radius: 14rpx;
  color: #5B8CFF; font-size: 28rpx; font-weight: 600;
}
.quick-btn:active { background: #2A4BD8; color: #FFF; }

.sheet-input-wrap {
  display: flex; align-items: center;
  background: #1E2540; border-radius: 14rpx;
  padding: 20rpx 24rpx; margin-bottom: 32rpx;
}
.sheet-input-label { font-size: 24rpx; color: #8A93A8; margin-right: 20rpx; }
.sheet-input { flex: 1; color: #FFF; font-size: 34rpx; font-weight: 700; }

.sheet-confirm {
  text-align: center; padding: 26rpx 0;
  background: linear-gradient(90rdeg, #2A4BD8, #5B8CFF);
  border-radius: 18rpx; color: #FFF; font-size: 30rpx; font-weight: 600;
}
.sheet-confirm.busy { opacity: .6; }

.load-more {
  text-align: center; color: #5B8CFF; font-size: 24rpx;
  padding: 24rpx 0 8rpx; margin: 0 24rpx;
}
