.page { padding-bottom: 60rpx; }
.header {
  padding: 100rpx 32rpx 20rpx;
  display: flex; justify-content: space-between; align-items: flex-end;
}
.header-title { font-size: 40rpx; font-weight: 700; color: #FFF; }
.header-sub { font-size: 22rpx; color: #8A93A8; }

.chips-scroll { white-space: nowrap; padding: 0 24rpx; margin-bottom: 16rpx; }
.chips { display: inline-flex; }
.sort-scroll { margin-bottom: 24rpx; }
.sort-chip { font-size: 22rpx; }

/* 搜索框 */
.search-wrap { padding: 0 24rpx; margin-bottom: 16rpx; }
.search-input {
  background: #141A30; border-radius: 16rpx;
  padding: 18rpx 24rpx; font-size: 26rpx; color: #FFF;
}

/* 计划形式标签 & 昨日 */
.camp-tags { display: flex; align-items: center; gap: 16rpx; margin-top: 12rpx; }
.camp-type {
  font-size: 20rpx; color: #5B8CFF;
  background: rgba(91,140,255,.12);
  padding: 4rpx 14rpx; border-radius: 8rpx;
}
.camp-ypd { font-size: 20rpx; color: #6B7280; }

/* 详情弹层 */
.detail-tags { display: flex; gap: 12rpx; margin-top: 12rpx; align-items: center; }
.detail-grid { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 24rpx; }
.dg-item {
  width: calc(33.33% - 8rpx); box-sizing: border-box;
  background: #1A2138; border-radius: 12rpx;
  display: flex; flex-direction: column; align-items: center; padding: 18rpx 0;
}
.dg-v { font-size: 26rpx; font-weight: 700; color: #FFF; }
.dg-l { font-size: 20rpx; color: #8A93A8; margin-top: 6rpx; }
.detail-sec-title { font-size: 24rpx; color: #8A93A8; margin: 28rpx 0 12rpx; }
/* 历史区间切换 */
.detail-chips { display: flex; gap: 12rpx; margin-top: 24rpx; }
.detail-chips .chip { padding: 8rpx 26rpx; font-size: 22rpx; }
.detail-sum {
  font-size: 22rpx; color: #E5E9F2; background: #1A2138;
  border-radius: 10rpx; padding: 14rpx 20rpx; margin-top: 16rpx;
}
.detail-actions { display: flex; gap: 16rpx; margin-top: 32rpx; }
.detail-actions .act-btn { flex: 1; }

/* 计划卡 */
.camp-card {
  background: #141A30; border-radius: 24rpx;
  padding: 28rpx; margin: 0 24rpx 24rpx;
}
.camp-head { display: flex; justify-content: space-between; align-items: flex-start; }
.camp-name { font-size: 28rpx; color: #FFF; font-weight: 600; flex: 1; margin-right: 16rpx; }
.camp-status { flex-shrink: 0; font-size: 20rpx; padding: 6rpx 18rpx; border-radius: 999rpx; }
.st-on { background: rgba(46,219,139,.12); color: #2EDB8B; }
.st-off { background: rgba(138,147,168,.12); color: #8A93A8; }

.camp-budget { margin: 24rpx 0 8rpx; }
.progress-track { height: 12rpx; background: #1E2540; border-radius: 999rpx; overflow: hidden; }
.progress-fill { height: 100%; border-radius: 999rpx; background: linear-gradient(90deg, #2A4BD8, #5B8CFF); }
/* 档位宽度类 w0~w100 (每10%一档), 替代内联 style */
.w0 { width: 2%; }
.w10 { width: 10%; } .w20 { width: 20%; } .w30 { width: 30%; } .w40 { width: 40%; }
.w50 { width: 50%; } .w60 { width: 60%; } .w70 { width: 70%; } .w80 { width: 80%; }
.w90 { width: 90%; } .w100 { width: 100%; }
.fill-hot { background: linear-gradient(90deg, #D84A2A, #FF5A5A); }
.fill-hot { background: linear-gradient(90deg, #D84A2A, #FF5A5A); }
.camp-budget-meta {
  display: flex; justify-content: space-between;
  font-size: 22rpx; color: #6B7280; margin-top: 10rpx;
}

.camp-metrics { display: flex; gap: 48rpx; margin: 16rpx 0 8rpx; }
.camp-metric { display: flex; align-items: baseline; gap: 12rpx; }
.cm-label { font-size: 22rpx; color: #6B7280; }
.cm-value { font-size: 30rpx; font-weight: 600; color: #FFF; }
.cm-delta { font-size: 20rpx; }

.camp-actions {
  display: flex; gap: 16rpx; margin-top: 24rpx;
  padding-top: 24rpx; border-top: 1rpx solid #1A2138;
}
.act-btn {
  flex: 1; text-align: center; padding: 16rpx 0;
  border-radius: 14rpx; font-size: 26rpx;
}
.act-pause { background: rgba(255,90,90,.12); color: #FF5A5A; }
.act-enable { background: rgba(46,219,139,.12); color: #2EDB8B; }
.act-budget {
  background: linear-gradient(135deg, #2A4BD8, #5B8CFF);
  color: #FFF; font-weight: 600;
  box-shadow: 0 4rpx 16rpx rgba(42, 75, 216, .35);
}
.act-budget:active { opacity: .85; }

/* 弹层遮罩: 盖过自定义 tabBar(z-index 999) */
.mask {
  position: fixed; inset: 0;
  background: rgba(0,0,0,.65);
  z-index: 2000;
  display: flex; align-items: flex-end;
}
.sheet {
  width: 100%; background: #161C34;
  border-radius: 32rpx 32rpx 0 0;
  padding: 40rpx 36rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
/* 弹层内容可滚动, 保证操作按钮可达 */
.sheet-scroll { max-height: 72vh; }

/* 详情图例 */
.legend-dot {
  display: inline-block; width: 14rpx; height: 14rpx;
  border-radius: 50%; background: #F5A623; margin: 0 6rpx 0 16rpx;
}
.legend-line {
  display: inline-block; width: 22rpx; height: 4rpx;
  background: #5B8CFF; margin-right: 6rpx;
}

/* 详情趋势: 柱 + CPA 点叠加 */
.detail-trend { display: flex; align-items: flex-end; height: 220rpx; gap: 10rpx; }
.dt-wrap { flex: 1; display: flex; flex-direction: column; align-items: center; height: 100%; }
.dt-body { position: relative; flex: 1; width: 100%; display: flex; align-items: flex-end; justify-content: center; }
.dt-bar { width: 100%; min-height: 6rpx; border-radius: 6rpx 6rpx 0 0; background: #2A4BD8; }
.dt-bar.hot { background: #5B8CFF; }
.dt-cpa {
  position: absolute; left: 50%; transform: translate(-50%, 50%);
  width: 16rpx; height: 16rpx; border-radius: 50%;
  background: #F5A623; border: 3rpx solid #161C34; box-sizing: content-box;
  z-index: 2;
}
.dt-label { font-size: 18rpx; color: #5A6379; }
/* CPA 金额固定行, 无值用空格占位保证 x 轴对齐 */
.dt-cpa-text {
  display: block; height: 26rpx; line-height: 26rpx;
  font-size: 18rpx; color: #F5A623; text-align: center;
}
.sheet-title { font-size: 32rpx; font-weight: 700; color: #FFF; }
.sheet-camp { font-size: 26rpx; color: #A8B0C4; margin-top: 12rpx; }
.sheet-current { font-size: 22rpx; color: #6B7280; margin-top: 6rpx; }

.quick-row { display: flex; gap: 16rpx; margin: 32rpx 0; }
.quick-btn {
  flex: 1; text-align: center; padding: 20rpx 0;
  background: #1E2540; border-radius: 14rpx;
  color: #5B8CFF; font-size: 28rpx; font-weight: 600;
}
.quick-btn:active { background: #2A4BD8; color: #FFF; }

.sheet-input-wrap {
  display: flex; align-items: center;
  background: #1E2540; border-radius: 14rpx;
  padding: 20rpx 24rpx; margin-bottom: 32rpx;
}
.sheet-input-label { font-size: 24rpx; color: #8A93A8; margin-right: 20rpx; }
.sheet-input { flex: 1; color: #FFF; font-size: 34rpx; font-weight: 700; }

.sheet-confirm {
  text-align: center; padding: 26rpx 0;
  background: linear-gradient(90deg, #2A4BD8, #5B8CFF);
  border-radius: 18rpx; color: #FFF; font-size: 30rpx; font-weight: 600;
}
.sheet-confirm.busy { opacity: .6; }

.load-more {
  text-align: center; color: #5B8CFF; font-size: 24rpx;
  padding: 24rpx 0 8rpx; margin: 0 24rpx;
}
