<view class="page">
  <view class="header">
    <view class="header-title">计划管理</view>
    <view class="header-sub">{{sourceText}} · 共{{campaigns.length}}个 · 在投{{activeCount}}</view>
  </view>

  <!-- 搜索框 -->
  <view class="search-wrap">
    <input class="search-input" placeholder="搜索计划名称 / 形式" value="{{searchKey}}" bindinput="onSearch" confirm-type="search" />
  </view>

  <!-- 分类筛选 -->
  <scroll-view scroll-x class="chips-scroll" enhanced show-scrollbar="{{false}}">
    <view class="chips">
      <view class="chip {{filter === 'spending' ? 'active' : ''}}" bindtap="setFilter" data-f="spending">本场有消耗</view>
      <view class="chip {{filter === 'zero' ? 'active' : ''}}" bindtap="setFilter" data-f="zero">未启动</view>
      <view class="chip {{filter === '投放中' ? 'active' : ''}}" bindtap="setFilter" data-f="投放中">投放中</view>
      <view class="chip {{filter === '已暂停' ? 'active' : ''}}" bindtap="setFilter" data-f="已暂停">已暂停</view>
      <view class="chip {{filter === 'all' ? 'active' : ''}}" bindtap="setFilter" data-f="all">全部</view>
    </view>
  </scroll-view>

  <!-- 排序 -->
  <scroll-view scroll-x class="chips-scroll sort-scroll" enhanced show-scrollbar="{{false}}">
    <view class="chips">
      <view class="chip sort-chip {{sortKey === 'cost' ? 'active' : ''}}" bindtap="setSort" data-k="cost">消耗↓</view>
      <view class="chip sort-chip {{sortKey === 'cpa' ? 'active' : ''}}" bindtap="setSort" data-k="cpa">CPA↓</view>
      <view class="chip sort-chip {{sortKey === 'ycost' ? 'active' : ''}}" bindtap="setSort" data-k="ycost">昨日↓</view>
      <view class="chip sort-chip {{sortKey === 'w7cost' ? 'active' : ''}}" bindtap="setSort" data-k="w7cost">7日↓</view>
      <view class="chip sort-chip {{sortKey === 'w7cpa' ? 'active' : ''}}" bindtap="setSort" data-k="w7cpa">7日CPA↓</view>
    </view>
  </scroll-view>

  <!-- 计划列表 (紧凑行, 历史数据直接展示) -->
  <view class="camp-card" wx:for="{{shownCampaigns}}" wx:key="id" bindtap="openDetail" data-id="{{item.id}}">
    <view class="camp-head">
      <view class="camp-name">{{item.name}}</view>
      <view class="camp-status {{item.status === '投放中' ? 'st-on' : 'st-off'}}">{{item.status}}</view>
    </view>
    <view class="camp-tags">
      <text class="camp-type">{{item.type}}</text>
    </view>

    <!-- 当日数据 (仅当日有消耗时展示) -->
    <block wx:if="{{item.cost > 0}}">
      <view class="camp-budget">
        <view class="progress-track">
          <view class="progress-fill {{item.fillCls}} {{item.budgetPct > 80 ? 'fill-hot' : ''}}"></view>
        </view>
        <view class="camp-budget-meta">
          <text>{{item.fmtCost}} / ¥{{item.budget}}</text>
          <text>{{item.budgetPct}}%</text>
        </view>
      </view>
      <view class="camp-metrics">
        <view class="camp-metric"><text class="cm-label">线索</text><text class="cm-value">{{item.leads}}</text></view>
        <view class="camp-metric"><text class="cm-label">CPA</text><text class="cm-value">{{item.fmtCpa}}</text></view>
        <view class="camp-metric"><text class="cm-label">开口</text><text class="cm-value">{{item.opens}}</text></view>
        <view class="camp-metric"><text class="cm-label">CPM</text><text class="cm-value">¥{{item.cpm}}</text></view>
      </view>
    </block>

    <!-- 历史行: 昨日 / 近7日 (恒显示, 找历史好计划不用点详情) -->
    <view class="hist-row">
      <view class="hist-cell">
        <text class="hist-k">昨日</text>
        <text class="hist-v">¥{{item.yCost}}<text wx:if="{{item.yLeads}}" class="hist-sub"> / {{item.yLeads}}线索 / CPA¥{{item.yCpa}}</text><text wx:else class="hist-sub"> 未投</text></text>
      </view>
      <view class="hist-cell">
        <text class="hist-k">近7日</text>
        <text class="hist-v">¥{{item.w7Cost}}<text wx:if="{{item.w7Leads}}" class="hist-sub"> / {{item.w7Leads}}线索 / CPA¥{{item.w7Cpa}}</text><text wx:else class="hist-sub"> 未投</text></text>
      </view>
    </view>

    <view class="camp-actions">
      <view class="act-btn {{item.status === '投放中' ? 'act-pause' : 'act-enable'}}" catchtap="onToggle" data-id="{{item.id}}" data-status="{{item.status}}">
        {{item.status === '投放中' ? '暂停' : '启用'}}
      </view>
      <view class="act-btn act-budget" catchtap="openBudget" data-id="{{item.id}}">调整预算</view>
    </view>
  </view>

  <view wx:if="{{!campaigns.length}}" class="empty">无匹配计划</view>
  <view wx:if="{{shownCampaigns.length < campaigns.length}}" class="load-more" bindtap="loadMore">
    加载更多 ({{shownCampaigns.length}}/{{campaigns.length}})
  </view>

  <!-- 计划详情弹层 -->
  <view class="mask" wx:if="{{detailOpen}}" bindtap="closeDetail">
    <view class="sheet" catchtap="">
      <scroll-view scroll-y class="sheet-scroll">
        <view class="sheet-title">{{detailCampaign.name}}</view>
        <view class="detail-tags">
          <text class="camp-status {{detailCampaign.status === '投放中' ? 'st-on' : 'st-off'}}">{{detailCampaign.status}}</text>
          <text class="camp-type">{{detailCampaign.type}}</text>
        </view>
        <view class="detail-grid">
          <view class="dg-item"><text class="dg-v">{{detailCampaign.fmtCost}}</text><text class="dg-l">今日消耗</text></view>
          <view class="dg-item"><text class="dg-v">{{detailCampaign.leads}}</text><text class="dg-l">今日线索</text></view>
          <view class="dg-item"><text class="dg-v">{{detailCampaign.fmtCpa}}</text><text class="dg-l">CPA</text></view>
          <view class="dg-item"><text class="dg-v">¥{{detailCampaign.yesterday_cost}}</text><text class="dg-l">昨日消耗</text></view>
          <view class="dg-item"><text class="dg-v">{{detailCampaign.opens}} / {{detailCampaign.retains}}</text><text class="dg-l">开口/留资</text></view>
          <view class="dg-item"><text class="dg-v">{{detailCampaign.budgetPct}}%</text><text class="dg-l">预算使用</text></view>
        </view>
        <view class="detail-chips">
          <view class="chip {{detailRange === 'y' ? 'active' : ''}}" bindtap="setDetailRange" data-r="y">昨日</view>
          <view class="chip {{detailRange === 'd3' ? 'active' : ''}}" bindtap="setDetailRange" data-r="d3">近3天</view>
          <view class="chip {{detailRange === 'd7' ? 'active' : ''}}" bindtap="setDetailRange" data-r="d7">近7天</view>
        </view>
        <view class="detail-sum" wx:if="{{detailBars.length}}">
          区间合计: 消耗 {{detailSum.cost}} · 线索 {{detailSum.leads}} · CPA {{detailSum.cpa}}
        </view>
        <view class="detail-sec-title" wx:if="{{detailBars.length}}">历史消耗 <text class="legend-dot"></text>柱=消耗 <text class="legend-line"></text>点=CPA</view>
        <view class="detail-trend" wx:if="{{detailBars.length}}">
          <view class="dt-wrap" wx:for="{{detailBars}}" wx:key="d">
            <view class="dt-body">
              <view class="dt-cpa" wx:if="{{item.cpaPct !== null}}" style="bottom: {{item.cpaPct}}rpx"></view>
              <view class="dt-bar {{item.hot ? 'hot' : ''}}" style="height: {{item.pct}}rpx"></view>
            </view>
            <text class="dt-cpa-text">{{item.cpa ? '¥' + item.cpa : ' '}}</text>
            <text class="dt-label">{{item.d}}</text>
          </view>
        </view>
        <view class="detail-actions">
          <view class="act-btn {{detailCampaign.status === '投放中' ? 'act-pause' : 'act-enable'}}" catchtap="onToggle" data-id="{{detailCampaign.id}}" data-status="{{detailCampaign.status}}">
            {{detailCampaign.status === '投放中' ? '暂停计划' : '启用计划'}}
          </view>
          <view class="act-btn act-budget" catchtap="openBudget" data-id="{{detailCampaign.id}}">调整预算</view>
        </view>
      </scroll-view>
    </view>
  </view>

  <!-- 调整预算底部弹层 -->
  <view class="mask" wx:if="{{budgetOpen}}" bindtap="closeBudget">
    <view class="sheet" catchtap="">
      <view class="sheet-title">调整预算</view>
      <view class="sheet-camp">{{budgetCampaign.name}}</view>
      <view class="sheet-current">当前预算 ¥{{budgetCampaign.budget}}</view>
      <view class="quick-row">
        <view class="quick-btn" bindtap="quickAdd" data-v="500">+500</view>
        <view class="quick-btn" bindtap="quickAdd" data-v="1000">+1,000</view>
        <view class="quick-btn" bindtap="quickAdd" data-v="2000">+2,000</view>
      </view>
      <view class="sheet-input-wrap">
        <text class="sheet-input-label">新预算</text>
        <input class="sheet-input" type="digit" value="{{budgetValue}}" bindinput="onBudgetInput" />
      </view>
      <view class="sheet-confirm {{budgetBusy ? 'busy' : ''}}" bindtap="confirmBudget">
        {{budgetBusy ? '提交中...' : '确认调整'}}
      </view>
    </view>
  </view>
</view>
