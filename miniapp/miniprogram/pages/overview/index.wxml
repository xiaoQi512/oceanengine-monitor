<view class="page">
  <!-- 顶部 -->
  <view class="header">
    <view class="header-title">巨量引擎监控</view>
    <view class="header-sub">
      <text class="src-dot {{source === 'cloud' || source === 'db' ? 'dot-live' : 'dot-mock'}}"></text>
      <text>{{sourceText}} · {{updatedText}}</text>
    </view>
  </view>

  <!-- 直播状态条 -->
  <view class="live-bar">
    <view class="live-ind"></view>
    <text class="live-text">{{liveStatus}} · {{liveWindowText}}</text>
  </view>

  <!-- 消耗大卡 -->
  <view class="card cost-card">
    <view class="cost-label">
      今日消耗
      <text class="cost-vs {{costVsYesterday === '高于昨日' ? 'up' : 'down'}}">{{costVsYesterday}}</text>
      <text class="cost-cpa {{cpaDelta.cls}}">CPA {{fmtCpa}} {{cpaDelta.text}}</text>
    </view>
    <view class="cost-value">{{fmtCost}}</view>
    <view class="cost-progress">
      <view class="progress-track">
        <view class="progress-fill" style="width: {{summary.cost_progress}}%"></view>
      </view>
      <view class="progress-meta">
        <text>日预算 {{summary.cost_progress}}%</text>
        <text>时段进度 {{summary.time_progress}}%</text>
      </view>
    </view>
    <view class="pacing-tag {{pacing.health === 'good' ? 'tag-good' : pacing.health === 'fast' ? 'tag-fast' : 'tag-slow'}}">
      {{pacing.health_text}} · 预计日耗 ¥{{pacing.projected_daily}}
    </view>
  </view>

  <!-- 指标网格 -->
  <view class="grid">
    <view class="g-cell">
      <view class="g-label">昨日消耗</view>
      <view class="g-value">{{fmtYesterday}}</view>
      <view class="g-sub">线索 {{summary.yesterday_leads}}</view>
    </view>
    <view class="g-cell">
      <view class="g-label">15分钟速度</view>
      <view class="g-value">¥{{summary.speed_15m}}<text class="g-unit">/分</text></view>
      <view class="g-sub">整场均速 ¥{{summary.avg_speed}}/分</view>
    </view>
    <view class="g-cell">
      <view class="g-label">线索数</view>
      <view class="g-value">{{summary.leads}}</view>
      <view class="g-sub">开口留资率 {{summary.retain_rate}}%</view>
    </view>
    <view class="g-cell">
      <view class="g-label">CPL</view>
      <view class="g-value">¥{{summary.cpl}}</view>
      <view class="g-sub">开口成本 ¥{{summary.open_cost}}</view>
    </view>
    <view class="g-cell">
      <view class="g-label">千展成本</view>
      <view class="g-value">¥{{summary.cpm}}</view>
      <view class="g-sub">曝光 {{summary.impressions}} · CTR {{summary.ctr}}%</view>
    </view>
    <view class="g-cell">
      <view class="g-label">在投计划</view>
      <view class="g-value">{{summary.spending_count}}<text class="g-unit">个</text></view>
      <view class="g-sub">今日有消耗 {{summary.spending_today}} 个</view>
    </view>
  </view>

  <!-- 近15分钟 -->
  <view class="card">
    <view class="card-title">
      <text>近{{last15.minutes}}分钟新增</text>
      <text class="card-more">速度 ¥{{summary.speed_15m}}/分 · 近1小时 ¥{{last15.speed_1h}}/分</text>
    </view>
    <view class="m15-row">
      <view class="m15-item m15-wide">
        <text class="m15-l">消耗</text>
        <text class="m15-v">¥{{last15.spend}}</text>
        <text class="m15-delta {{deltas.spend > 0 ? 'up' : deltas.spend < 0 ? 'down' : ''}}" wx:if="{{deltas}}">{{deltas.spend === null ? '--' : (deltas.spend > 0 ? '+' : '') + deltas.spend + '%'}}</text>
      </view>
      <view class="m15-item">
        <text class="m15-l">线索</text>
        <text class="m15-v">{{last15.leads}}</text>
        <text class="m15-delta {{deltas.leads > 0 ? 'up' : deltas.leads < 0 ? 'down' : ''}}" wx:if="{{deltas}}">{{deltas.leads === null ? '--' : (deltas.leads > 0 ? '+' : '') + deltas.leads + '%'}}</text>
      </view>
      <view class="m15-item">
        <text class="m15-l">开口</text>
        <text class="m15-v">{{last15.opens}}</text>
        <text class="m15-delta {{deltas.opens > 0 ? 'up' : deltas.opens < 0 ? 'down' : ''}}" wx:if="{{deltas}}">{{deltas.opens === null ? '--' : (deltas.opens > 0 ? '+' : '') + deltas.opens + '%'}}</text>
      </view>
      <view class="m15-item">
        <text class="m15-l">CPM</text>
        <text class="m15-v">¥{{last15.cpm}}</text>
        <text class="m15-delta {{deltas.cpm > 0 ? 'up' : deltas.cpm < 0 ? 'down' : ''}}" wx:if="{{deltas}}">{{deltas.cpm === null ? '--' : (deltas.cpm > 0 ? '+' : '') + deltas.cpm + '%'}}</text>
      </view>
      <view class="m15-item">
        <text class="m15-l">CTR</text>
        <text class="m15-v">{{last15.ctr}}%</text>
        <text class="m15-delta {{deltas.ctr > 0 ? 'up' : deltas.ctr < 0 ? 'down' : ''}}" wx:if="{{deltas}}">{{deltas.ctr === null ? '--' : (deltas.ctr > 0 ? '+' : '') + deltas.ctr + '%'}}</text>
      </view>
    </view>
    <view class="top5-title">新增消耗 TOP5</view>
    <view class="top5-item {{item.warn ? 'top5-warn' : ''}}" wx:for="{{last15.top5}}" wx:key="name">
      <text class="top5-rank {{item.warn ? 'rank-warn' : ''}}">{{index + 1}}</text>
      <view class="top5-info">
        <text class="top5-name">{{item.name}}</text>
        <view class="top5-meta">
          <text wx:if="{{item.cpl}}" class="top5-cpl">线索成本 ¥{{item.cpl}} · {{item.leads}}线索</text>
          <text wx:if="{{item.warn}}" class="top5-flag">⚠ 无转化预警</text>
        </view>
      </view>
      <text class="top5-cost {{item.warn ? 'up' : ''}}">¥{{item.cost}}</text>
    </view>
    <view wx:if="{{!last15.top5.length}}" class="empty">暂无增量数据</view>
  </view>

  <!-- 1小时趋势 -->
  <view class="card">
    <view class="card-title"><text>过去1小时 · 5分钟增量</text></view>
    <view class="trend">
      <view class="trend-bar-wrap" wx:for="{{hourlyBars}}" wx:key="t">
        <view class="trend-bar {{item.hot ? 'trend-bar-hot' : ''}}" style="height: {{item.pct}}rpx"></view>
        <text class="trend-hour" wx:if="{{item.showLabel}}">{{item.t}}</text>
        <text class="trend-hour trend-hour-blank" wx:else></text>
      </view>
    </view>
  </view>

  <!-- 近7日 -->
  <view class="card">
    <view class="card-title"><text>近7日消耗</text><text class="card-more">日均 ¥{{weeklyAvg}}</text></view>
    <view class="trend">
      <view class="trend-bar-wrap" wx:for="{{weeklyBars}}" wx:key="date">
        <view class="trend-bar {{item.hot ? 'trend-bar-hot' : ''}}" style="height: {{item.pct}}rpx"></view>
        <text class="trend-hour">{{item.date}}</text>
      </view>
    </view>
  </view>

  <!-- 告警速览 -->
  <view class="card">
    <view class="card-title"><text>实时告警</text></view>
    <view class="alert-item" wx:for="{{alerts}}" wx:key="id">
      <view class="alert-dot alert-dot-{{item.severity}}"></view>
      <view class="alert-body">
        <view class="alert-msg">{{item.message}}</view>
        <view class="alert-meta">{{item.campaign}} · {{item.time}}</view>
      </view>
    </view>
    <view wx:if="{{!alerts.length}}" class="empty">暂无告警</view>
  </view>
</view>
