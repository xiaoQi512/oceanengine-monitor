.page { padding-bottom: 40rpx; }

.header {
  padding: 100rpx 32rpx 20rpx;
  display: flex; justify-content: space-between; align-items: flex-end;
}
.header-title { font-size: 40rpx; font-weight: 700; color: #FFFFFF; }
.header-sub { font-size: 22rpx; color: #8A93A8; display: flex; align-items: center; }
.src-dot { width: 12rpx; height: 12rpx; border-radius: 50%; margin-right: 8rpx; display: inline-block; }
.dot-live { background: #2EDB8B; box-shadow: 0 0 8rpx #2EDB8B; }
.dot-mock { background: #F5A623; box-shadow: 0 0 8rpx #F5A623; }

/* 直播状态条 */
.live-bar {
  margin: 8rpx 24rpx 24rpx;
  padding: 18rpx 24rpx;
  background: linear-gradient(90deg, rgba(46, 219, 139, 0.12), rgba(46, 219, 139, 0.04));
  border: 1rpx solid rgba(46, 219, 139, 0.25);
  border-radius: 16rpx;
  display: flex; align-items: center;
}
.live-ind {
  width: 14rpx; height: 14rpx; border-radius: 50%;
  background: #2EDB8B; margin-right: 14rpx;
  animation: pulse 1.6s ease-in-out infinite;
}
@keyframes pulse { 0%,100% { opacity: 1; } 50% { opacity: 0.35; } }
.live-text { font-size: 24rpx; color: #2EDB8B; }

/* 消耗大卡 */
.cost-card { padding: 36rpx 32rpx; }
.cost-label { font-size: 24rpx; color: #8A93A8; display: flex; align-items: center; gap: 12rpx; }
.cost-vs { font-size: 20rpx; padding: 2rpx 12rpx; border-radius: 999rpx; }
.up.cost-vs { background: rgba(255,90,90,.12); }
.down.cost-vs { background: rgba(46,219,139,.12); }
.cost-cpa { font-size: 20rpx; color: #8A93A8; }
.cost-value {
  font-size: 76rpx; font-weight: 700; color: #FFFFFF;
  font-family: "D-DIN", "DIN Alternate", sans-serif;
  margin: 8rpx 0 24rpx;
}
.progress-track { height: 14rpx; background: #1E2540; border-radius: 999rpx; overflow: hidden; }
.progress-fill { height: 100%; border-radius: 999rpx; background: linear-gradient(90deg, #2A4BD8, #5B8CFF); }
.progress-meta { display: flex; justify-content: space-between; font-size: 22rpx; color: #6B7280; margin-top: 12rpx; }
.pacing-tag {
  display: inline-block; margin-top: 20rpx;
  padding: 6rpx 20rpx; border-radius: 999rpx; font-size: 22rpx;
}
.tag-good { background: rgba(46,219,139,.12); color: #2EDB8B; }
.tag-fast { background: rgba(255,90,90,.12); color: #FF5A5A; }
.tag-slow { background: rgba(245,166,35,.12); color: #F5A623; }

/* 指标网格 */
.grid { display: flex; flex-wrap: wrap; gap: 16rpx; margin: 0 24rpx 24rpx; }
.g-cell {
  width: calc(50% - 8rpx); box-sizing: border-box;
  background: #141A30; border-radius: 20rpx; padding: 24rpx;
}
.g-label { font-size: 22rpx; color: #8A93A8; }
.g-value {
  font-size: 40rpx; font-weight: 700; color: #FFF; margin-top: 10rpx;
  font-family: "D-DIN", "DIN Alternate", sans-serif;
}
.g-unit { font-size: 22rpx; font-weight: 400; color: #8A93A8; }
.g-sub { font-size: 20rpx; color: #6B7280; margin-top: 8rpx; }

/* 近15分钟 */
.m15-row { display: flex; gap: 12rpx; }
.m15-item {
  flex: 1; background: #1A2138; border-radius: 14rpx;
  display: flex; flex-direction: column; align-items: center; padding: 20rpx 0;
  min-width: 0;
}
/* 消耗格加宽: 容纳 4 位整数+2 位小数 */
.m15-wide { flex: 1.6; }
.m15-v { font-size: 30rpx; font-weight: 700; color: #FFF; max-width: 100%; }
.m15-l { font-size: 20rpx; color: #8A93A8; margin-top: 6rpx; }
.top5-title { font-size: 24rpx; color: #8A93A8; margin: 24rpx 0 8rpx; }
.top5-item { display: flex; align-items: center; padding: 14rpx 0; border-bottom: 1rpx solid #1A2138; }
.top5-item:last-child { border-bottom: none; }
.top5-warn { background: rgba(255,90,90,.05); border-radius: 12rpx; padding-left: 12rpx; padding-right: 12rpx; }
.top5-rank {
  width: 36rpx; height: 36rpx; border-radius: 10rpx; flex-shrink: 0;
  background: #2A4BD8; color: #FFF; font-size: 22rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center; margin-right: 16rpx;
}
.rank-warn { background: #FF5A5A; }
.top5-info { flex: 1; overflow: hidden; margin-right: 16rpx; }
.top5-name { font-size: 24rpx; color: #E5E9F2; display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.top5-meta { display: flex; gap: 16rpx; margin-top: 4rpx; }
.top5-cpl { font-size: 20rpx; color: #8A93A8; }
.top5-flag { font-size: 20rpx; color: #FF5A5A; font-weight: 600; }
.top5-delta { font-size: 20rpx; color: #6B7280; flex-shrink: 0; margin-right: 10rpx; }
.top5-delta.up { color: #FF5A5A; }
.top5-delta.down { color: #2EDB8B; }
.top5-cost { font-size: 26rpx; font-weight: 600; flex-shrink: 0; }

/* 柱状图 (1小时/近7日共用) */
.trend { display: flex; align-items: flex-end; height: 200rpx; gap: 8rpx; }
.trend-bar-wrap { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: flex-end; height: 100%; }
.trend-bar { width: 100%; min-height: 6rpx; border-radius: 6rpx 6rpx 0 0; background: #2A4BD8; opacity: .75; }
.trend-bar-hot { background: #5B8CFF; opacity: 1; }
.trend-hour {
  font-size: 18rpx; color: #5A6379; margin-top: 8rpx;
  height: 26rpx; line-height: 26rpx;  /* 固定行高: 空占位不塌陷, X轴对齐 */
}
.trend-hour-blank { visibility: hidden; }

/* 近15分钟环比 */
.m15-delta { font-size: 20rpx; margin-top: 4rpx; }
.m15-delta.up { color: #FF5A5A; }
.m15-delta.down { color: #2EDB8B; }
.card-more { color: #8A93A8; font-size: 22rpx; }

/* 表格 (班次/形式) */
.table-head {
  display: flex; padding: 8rpx 0; border-bottom: 1rpx solid #1E2540;
  font-size: 20rpx; color: #5A6379;
}
.th { flex: 1; text-align: right; }
.th-shift { flex: 2.2; text-align: left; }
.table-row {
  display: flex; align-items: center; padding: 18rpx 0;
  border-bottom: 1rpx solid #1A2138;
}
.table-row:last-child { border-bottom: none; }
.tr-shift { display: block; font-size: 24rpx; color: #E5E9F2; }
.tr-anchor { display: block; font-size: 20rpx; color: #5B8CFF; margin-top: 4rpx; }
.tr-v { flex: 1; text-align: right; font-size: 24rpx; color: #E5E9F2; }

/* 告警速览 */
.alert-item { display: flex; align-items: flex-start; padding: 16rpx 0; border-bottom: 1rpx solid #1A2138; }
.alert-item:last-child { border-bottom: none; }
.alert-dot { width: 14rpx; height: 14rpx; border-radius: 50%; margin: 12rpx 16rpx 0 0; flex-shrink: 0; }
.alert-dot-high { background: #FF5A5A; box-shadow: 0 0 10rpx rgba(255,90,90,.6); }
.alert-dot-medium { background: #F5A623; }
.alert-dot-low { background: #5B8CFF; }
.alert-body { flex: 1; }
.alert-msg { font-size: 26rpx; color: #E5E9F2; }
.alert-meta { font-size: 20rpx; color: #6B7280; margin-top: 6rpx; }
