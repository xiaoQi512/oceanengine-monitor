{
  "version": "1.0",
  "updatedAt": "2026-08-17",
  "metrics": [
    {
      "id": "spend_total",
      "name": "累计消耗",
      "aliases": ["totalSpend", "stat_cost"],
      "definition": "统计周期内账户竞价消耗",
      "formula": "SUM(stat_cost)",
      "unit": "CNY",
      "source": "projects/list.total_metrics.stat_cost",
      "accountScope": "main_live",
      "businessScope": "all",
      "granularity": "5min/15min",
      "attributionWindow": "none",
      "status": "active"
    },
    {
      "id": "conversions_total",
      "name": "累计转化",
      "aliases": ["totalConversions", "convert_cnt"],
      "definition": "统计周期内账户转化次数",
      "formula": "SUM(convert_cnt)",
      "unit": "COUNT",
      "source": "projects/list.total_metrics.convert_cnt",
      "accountScope": "main_live",
      "businessScope": "all",
      "granularity": "5min/15min",
      "attributionWindow": "none",
      "status": "active"
    },
    {
      "id": "leads_total",
      "name": "线索数",
      "aliases": ["totalLeads", "leads", "clue_message_count"],
      "definition": "归因线索数，代表可跟进的销售线索总量",
      "formula": "SUM(attribution_all_convert_clue_count) 或 SUM(clue_message_count)",
      "unit": "COUNT",
      "source": "projects/list.total_metrics.attribution_all_convert_clue_count",
      "accountScope": "main_live",
      "businessScope": "all",
      "granularity": "5min/15min",
      "attributionWindow": "none",
      "status": "active"
    },
    {
      "id": "cpl_total",
      "name": "综合CPL",
      "aliases": ["avgCPA", "conversion_cost"],
      "definition": "单次转化成本，消耗 / 转化",
      "formula": "SUM(stat_cost) / SUM(convert_cnt)",
      "unit": "CNY",
      "source": "计算字段",
      "accountScope": "main_live",
      "businessScope": "all",
      "granularity": "5min/15min",
      "attributionWindow": "none",
      "status": "active"
    },
    {
      "id": "spend_delta_15m",
      "name": "15分钟新增消耗",
      "aliases": ["spendLast15min", "deltaSpend15min"],
      "definition": "当前快照与前次快照的消耗差值",
      "formula": "totalSpend(now) - totalSpend(prev)",
      "unit": "CNY",
      "source": "DB snapshots 差值",
      "accountScope": "main_live",
      "businessScope": "all",
      "granularity": "15min",
      "attributionWindow": "none",
      "status": "active"
    },
    {
      "id": "conv_delta_15m",
      "name": "15分钟新增转化",
      "aliases": ["convLast15min", "deltaConv15min"],
      "definition": "当前快照与前次快照的转化差值",
      "formula": "totalConversions(now) - totalConversions(prev)",
      "unit": "COUNT",
      "source": "DB snapshots 差值",
      "accountScope": "main_live",
      "businessScope": "all",
      "granularity": "15min",
      "attributionWindow": "none",
      "status": "active"
    },
    {
      "id": "speed_current",
      "name": "当前消耗速度",
      "aliases": ["speedCurrent", "speed"],
      "definition": "最近15分钟新增消耗 / 实际分钟数",
      "formula": "spend_delta_15m / age15",
      "unit": "CNY/MIN",
      "source": "计算字段",
      "accountScope": "main_live",
      "businessScope": "all",
      "granularity": "15min",
      "attributionWindow": "none",
      "status": "active"
    },
    {
      "id": "cpm",
      "name": "千展成本",
      "aliases": ["avgCPM", "cpm_platform"],
      "definition": "千次展示成本",
      "formula": "stat_cost / show_cnt * 1000",
      "unit": "CNY",
      "source": "projects/list.total_metrics.cpm_platform",
      "accountScope": "main_live",
      "businessScope": "all",
      "granularity": "5min/15min",
      "attributionWindow": "none",
      "status": "active"
    },
    {
      "id": "open_cost",
      "name": "开口成本",
      "aliases": ["totalSpend / totalPrivateMsgOpen"],
      "definition": "每产生一次私信开口的平均消耗",
      "formula": "totalSpend / totalPrivateMsgOpen",
      "unit": "CNY",
      "source": "计算字段",
      "accountScope": "main_live",
      "businessScope": "live",
      "granularity": "15min",
      "attributionWindow": "none",
      "status": "active"
    },
    {
      "id": "open_retain_rate",
      "name": "开口留资率",
      "aliases": ["openRetainRate"],
      "definition": "私信留资数 / 私信开口数",
      "formula": "privateMsgRetain / privateMsgOpen",
      "unit": "PERCENT",
      "source": "计算字段",
      "accountScope": "main_live",
      "businessScope": "live",
      "granularity": "15min",
      "attributionWindow": "none",
      "status": "active"
    },
    {
      "id": "budget_progress",
      "name": "预算使用率",
      "aliases": ["budgetUsed", "budgetPct"],
      "definition": "今日消耗 / 今日预算",
      "formula": "totalSpend / dailyBudget",
      "unit": "PERCENT",
      "source": "计算字段",
      "accountScope": "main_live",
      "businessScope": "all",
      "granularity": "5min/15min",
      "attributionWindow": "none",
      "status": "active"
    },
    {
      "id": "time_progress",
      "name": "时间进度",
      "aliases": ["timeProgress"],
      "definition": "当前时间占投放窗口比例",
      "formula": "(now - windowStart) / (windowEnd - windowStart)",
      "unit": "PERCENT",
      "source": "计算字段",
      "accountScope": "main_live",
      "businessScope": "all",
      "granularity": "15min",
      "attributionWindow": "none",
      "status": "active"
    },
    {
      "id": "active_plan_count",
      "name": "活跃计划数",
      "aliases": ["active", "activeCount"],
      "definition": "投放中且有消耗的计划数量",
      "formula": "COUNT(campaigns where status=投放中 AND spend>0)",
      "unit": "COUNT",
      "source": "collectAllData.campaigns",
      "accountScope": "main_live",
      "businessScope": "all",
      "granularity": "5min/15min",
      "attributionWindow": "none",
      "status": "active"
    },
    {
      "id": "dead_plan_count",
      "name": "疑似死亡计划数",
      "aliases": ["dead", "deadPlanCount"],
      "definition": "投放中但持续低耗计划数量",
      "formula": "COUNT(campaigns where lifecycle=dead)",
      "unit": "COUNT",
      "source": "lifecycle-analysis",
      "accountScope": "main_live",
      "businessScope": "all",
      "granularity": "15min",
      "attributionWindow": "none",
      "status": "active"
    },
    {
      "id": "ramping_up_count",
      "name": "起量计划数",
      "aliases": ["rampingUpCount"],
      "definition": "近15分钟新增消耗且趋势为起量的计划数",
      "formula": "COUNT(campaignDeltas where trend=起量)",
      "unit": "COUNT",
      "source": "campaign-deltas",
      "accountScope": "main_live",
      "businessScope": "all",
      "granularity": "15min",
      "attributionWindow": "none",
      "status": "active"
    },
    {
      "id": "dropping_plan_count",
      "name": "掉量计划数",
      "aliases": ["droppingCount"],
      "definition": "近15分钟消耗明显下降的计划数",
      "formula": "COUNT(campaignDeltas where trend=掉量)",
      "unit": "COUNT",
      "source": "campaign-deltas",
      "accountScope": "main_live",
      "businessScope": "all",
      "granularity": "15min",
      "attributionWindow": "none",
      "status": "active"
    }
  ]
}
